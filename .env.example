APP_ENV=development
DATABASE_URL=postgresql+psycopg://flyer:flyer@postgres:5432/flyer
REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-vl:8b
FLYER_STORAGE_PATH=/data
DISCOVERY_ENABLED=true
DISCOVERY_CRON=0 */6 * * *
CATALOG_COLLECTION_ENABLED=true
CATALOG_COLLECTION_CRON=0 6,14,22 * * *
CATALOG_V2_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
EXTRACTION_MAX_RETRIES=2
QWEN_TEMPERATURE=0
QWEN_REQUEST_TIMEOUT_SECONDS=10
QWEN_CONTEXT_SIZE=32768
QWEN_NUM_PREDICT=16384
EXTRACTION_MODE=tiles
TILE_OVERLAP_PERCENT=12
MAX_ASSET_SIZE_MB=50
JOB_LOCK_TIMEOUT_SECONDS=5400
LOG_LEVEL=INFO
DAVITA_TOKEN_FILE=/run/secrets/davita_dotenv
DAVITA_TOKEN_FILE_HOST=C:/path/to/davita/flutter_assets/dotenv
ASSAI_USERNAME=
ASSAI_PASSWORD=
ASSAI_BUNDLE_FILE=/run/secrets/meu_assai_bundle.js
ASSAI_BUNDLE_FILE_HOST=C:/path/to/meu_assai_hermes_decompiled.js
TENDA_PROXY_URL=
# Credenciais da API interna do app "Meu Atacadao" (ver
# docs/REVERSE-ENGINEERING-APP-API.md). OBRIGATORIAS: o codigo nao tem fallback;
# sem elas a coleta Atacadao falha com AtacadaoCredentialsMissing.
ATACADAO_APP_BASE_URL=https://freyr.portal.atacadao.com.br
ATACADAO_APP_CLIENT_ID=
ATACADAO_APP_CLIENT_SECRET=
ATACADAO_APP_USERNAME=
ATACADAO_APP_PASSWORD=
# So para scripts/ de Remote Config (nao usado pelo app)
ATACADAO_FIREBASE_API_KEY=
