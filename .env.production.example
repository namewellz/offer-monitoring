APP_IMAGE=ghcr.io/namewellz/offer-monitoring:latest
POSTGRES_DB=flyer
POSTGRES_USER=flyer
POSTGRES_PASSWORD=generate-a-long-hex-password

DISCOVERY_ENABLED=false
CATALOG_COLLECTION_ENABLED=false
CATALOG_COLLECTION_CRON=0 6,14,22 * * *
SCHEDULER_TIMEZONE=America/Sao_Paulo

ASSAI_USERNAME=
ASSAI_PASSWORD=
LOG_LEVEL=INFO

# Rota de saida do coletor Tenda quando o IP da Oracle e bloqueado pelo WAF.
# Deixe vazio para sair direto. Ex.: http://usuario:senha@SEU_IP:3128
TENDA_PROXY_URL=

# Credenciais da API interna do app "Meu Atacadao" (Keycloak, grant password).
# Ver docs/REVERSE-ENGINEERING-APP-API.md secao 7 para o contrato e a secao 9
# para o que fazer quando a Carrefour rotacionar. O codigo tem os valores
# observados como fallback, mas producao deve trazer os seus aqui.
ATACADAO_APP_BASE_URL=https://freyr.portal.atacadao.com.br
ATACADAO_APP_CLIENT_ID=
ATACADAO_APP_CLIENT_SECRET=
ATACADAO_APP_USERNAME=
ATACADAO_APP_PASSWORD=
# So para scripts/ de Remote Config (nao usado pelo app)
ATACADAO_FIREBASE_API_KEY=
